# Server-side Supabase access (bypasses RLS for API routes).
# Use the new secret key (sb_secret_...) if your project has one, otherwise
# the legacy service_role key also works.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key

# Public Supabase access (used by the browser for the Google OAuth handshake).
# Use the new publishable key (sb_publishable_...) if your project has one,
# otherwise the legacy anon key also works.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key

# Secret used to sign TRAC session cookies. Required in production —
# generate one with `openssl rand -base64 32`.
AUTH_SECRET=change-me-in-production

# Authorizes the scheduled loan sweep at /api/cron/refresh-loans. Vercel sends
# this as a bearer token on cron invocations. Required in production, otherwise
# that endpoint refuses to run.
CRON_SECRET=change-me-in-production

# Google self sign-up creates a student account on first visit (default on).
# Set to false to require an admin-created users row first.
# GOOGLE_OPEN_SIGNUP=true
# Optional allowlist — when either is set, only those addresses/domains may
# sign up via Google (overrides open sign-up).
# GOOGLE_ALLOWED_DOMAINS=trac.edu.ph,students.trac.edu.ph
# GOOGLE_ALLOWED_EMAILS=head.librarian@gmail.com
