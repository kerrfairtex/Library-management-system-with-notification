# Server-side Supabase access (bypasses RLS for API routes).
# The code uses SUPABASE_SERVICE_ROLE_KEY (or SUPABASE_URL + SUPABASE_ANON_KEY for browser).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public Supabase access (used by the browser for the Google OAuth handshake).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# Secret used to sign TRAC session cookies. Required in production —
# generate one with `openssl rand -base64 32`.
AUTH_SECRET=change-me-in-production

# Authorizes the scheduled loan sweep at /api/cron/refresh-loans. Vercel sends
# this as a bearer token on cron invocations. Required in production, otherwise
# that endpoint refuses to run.
CRON_SECRET=change-me-in-production
# The sweep is opt-in per deployment (src/lib/cron-policy.ts). Anything other
# than "true" makes the endpoint return 403, so no overdue / due-soon
# notifications are generated. Set to true on the ONE deployment that should
# run the schedule (Render: render.yaml; Vercel: project env).
CRON_SCHEDULE_ENABLED=true

# Origin of the separately hosted 3D bookshelf allowed to read
# /api/shelf-availability cross-origin. Same-origin /shelf needs no value.
# SHELF_ALLOWED_ORIGIN=https://your-vercel-bookshelf.vercel.app

# Canonical public URL of this desk; sitemap.xml is empty when unset.
# NEXT_PUBLIC_SITE_URL=https://your-render-desk.onrender.com

# Cross-origin links (NEXT_PUBLIC_* values are publicly visible in the browser).
# NEXT_PUBLIC_LIBRARY_ORIGIN: the Render TRAC desk URL, read by the Vercel
#   3D bookshelf to build borrow links (see src/app/shelf/site-config.ts).
# NEXT_PUBLIC_SHELF_ORIGIN: the Vercel 3D bookshelf URL, read by the desk's
#   KohaShell nav (src/components/KohaShell.tsx:21). When unset, the app uses
#   its existing hard-coded fallback. Set only to the approved shelf origin.
# NEXT_PUBLIC_LIBRARY_ORIGIN=https://your-render-desk.onrender.com
# NEXT_PUBLIC_SHELF_ORIGIN=https://your-vercel-bookshelf.vercel.app/

# Google self sign-up (default OFF — src/lib/google-access.ts). Set to true to
# create a pending student account on first visit; otherwise an admin-created
# users row is required.
# GOOGLE_OPEN_SIGNUP=true
# Optional allowlist — when either is set, only those addresses/domains may
# sign up via Google (overrides open sign-up).
# GOOGLE_ALLOWED_DOMAINS=trac.edu.ph,students.trac.edu.ph
# GOOGLE_ALLOWED_EMAILS=head.librarian@gmail.com

# Block desk checkout when a member's unpaid fines reach this many pesos
# (Koha "noissuescharge"). Unset or 0 = no block.
# FINE_BLOCK_THRESHOLD=100

# Optional e-mail copies of due-soon / overdue / hold-ready notices, sent by
# the daily sweep through Resend (https://resend.com, free tier available).
# Both must be set, and supabase/migrations/20261119_notification_email.sql
# must be applied. EMAIL_FROM must be on a domain verified in Resend.
# RESEND_API_KEY=re_your_key
# EMAIL_FROM=TRAC Library <library@your-domain.example>
